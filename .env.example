# Copy to .env and fill in. .env is gitignored and must stay that way.

# intervals.icu — Settings > Developer. The athlete id is the "i" number in your profile URL.
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# Anthropic — console.anthropic.com. Used by the coaching layer and the weekly summariser.
ANTHROPIC_API_KEY=

# TrainerRoad planned workouts, read from the calendar's public iCal feed.
# Google Calendar > Settings > (the TrainerRoad calendar) > Integrate calendar >
# "Public address in iCal format". Anyone with this URL can read the calendar.
# Pointing this at TrainerRoad's own iCal export instead also works and is fresher.
GCAL_ICAL_URL=

# Optional. Defaults to claude-haiku-4-5 for both.
# COACH_MODEL=
# SUMMARY_MODEL=
