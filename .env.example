# Copy to .env and fill in. .env is gitignored and must stay that way.

# intervals.icu — Settings > Developer. The athlete id is the "i" number in your profile URL.
# Used for both reading (activities, wellness) and writing (the planned-workout calendar).
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# Anthropic — console.anthropic.com. Used by the coaching layer and the weekly summariser.
ANTHROPIC_API_KEY=

# Optional. Both default to claude-haiku-5-5; SUMMARY_MODEL falls back to COACH_MODEL.
# COACH_MODEL=
# SUMMARY_MODEL=

# Optional. The background maintenance loop in src/api/app.py: pull from intervals.icu,
# roll the plan forward, push the horizon. Runs only while scripts/serve.py is up.
# SYNC_INTERVAL_MINUTES=60
# FITNESS_COACH_NO_SCHEDULER=1
